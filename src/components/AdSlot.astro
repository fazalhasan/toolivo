---
// AdSlot.astro
interface Props {
  slotId?: string;
  format?: 'horizontal' | 'rectangle';
  className?: string;
}

const { slotId = 'toolivo-ad-slot', format = 'horizontal', className = '' } = Astro.props;
---

<div class={`ad-slot-container ${className}`}>
  <div class="ad-slot-box" style={format === 'horizontal' ? 'min-width: 320px; max-width: 728px; width: 100%; min-height: 90px;' : 'width: 300px; min-height: 250px;'}>
    <div class="ad-slot-label">ADVERTISEMENT</div>
    <div class="ad-slot-placeholder">
      <span>Reserved Sponsorship & Ad Space</span>
    </div>
  </div>
</div>
